public class Question3 {

    public static boolean isOdd(int number) {
        return number % 2 != 0;
    }

    public static void main(String[] args) {

        System.out.println("Even numbers between 1 and 100:");

        for (int i = 1; i <= 100; i++) {

            if (!isOdd(i)) {
                System.out.print(i + " ");
            }
        }
    }
}